---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Desktop from "@/components/Desktop.astro";

const repo = "https://github.com/HYP3R00T/hypershell";
const palette = [
  ["Carbon", "#090909"], ["Surface", "#191919"], ["Raised", "#262626"],
  ["Ink", "#ECECEC"], ["Accent", "#98B5D3"],
];
---
<BaseLayout title="Linear Carbon — Hyper Shell" description="Explore the Linear Carbon desktop theme for Omarchy in an interactive browser preview.">
  <header class="site-header">
    <div class="site-width nav">
      <a class="brand" href="#" aria-label="Linear Carbon home"><span class="brand-mark" aria-hidden="true"></span>Linear Carbon</a>
      <nav aria-label="Main navigation">
        <a href="#demo">Desktop</a>
        <a href="#install">Install</a>
        <a class="repo-link" href={repo}>GitHub</a>
      </nav>
    </div>
  </header>
  <main class="site-width">
    <section class="intro" aria-labelledby="page-title">
      <div>
        <p class="eyebrow"><span></span> An Omarchy theme</p>
        <h1 id="page-title">Linear Carbon<span>.</span></h1>
      </div>
      <p class="intro-copy">A charcoal desktop, framed edge to edge. Try the notch, launcher, and panels directly in the preview.</p>
    </section>

    <Desktop />

    <section id="install" class="install-section" aria-labelledby="install-title">
      <div>
        <p class="eyebrow"><span></span> The theme</p>
        <h2 id="install-title">On your desktop</h2>
        <p>Linear Carbon brings the same charcoal surfaces and cool blue accent to the Omarchy shell, Hyprland, and supported apps.</p>
        <a class="install-link" href={repo + "/tree/main/themes/linear-carbon#install"}>Installation guide</a>
      </div>
      <dl class="palette" aria-label="Linear Carbon palette">
        {palette.map(([name, color]) => (
          <div><span class="swatch" style={`--swatch: ${color}`}></span><dt>{name}</dt><dd>{color}</dd></div>
        ))}
      </dl>
    </section>
  </main>
  <footer class="site-width site-footer">
    <span>Linear Carbon · Hyper Shell</span>
    <span>Wallpaper by Ismail Inceoglu (Seven-teenth)</span>
  </footer>
</BaseLayout>
