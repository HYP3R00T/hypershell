---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "@/styles/global.css";
import { repository, sitePath } from "@/data/themes";

interface Props {
  title: string;
  description: string;
  themePage?: boolean;
}

const { title, description, themePage = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0d10" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href={themePage ? "#demo" : "#main-content"}>Skip to content</a>
    <header class="site-header">
      <div class="site-width nav">
        <a class="brand" href={sitePath()}><span class="brand-mark" aria-hidden="true"></span>HyperShell</a>
        <nav aria-label="Main navigation">
          <a href={sitePath("#themes")}>Themes</a>
          {themePage && <a href="#demo">Desktop</a>}
          {themePage && <a href="#install">Install</a>}
          <a class="repo-link" href={repository}>GitHub</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-width site-footer">
      <a class="brand" href={sitePath()}><span class="brand-mark" aria-hidden="true"></span>HyperShell</a>
      <nav aria-label="Footer navigation">
        <a href={sitePath("#themes")}>Themes</a>
        <a href={repository}>GitHub</a>
      </nav>
    </footer>
  </body>
</html>
