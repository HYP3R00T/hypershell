#!/usr/bin/env bash
set -euo pipefail

source_dir="${OMARCHY_PATH:-/usr/share/omarchy}/shell/plugins/menu"
theme_notch=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
plugin_id="${USER:-$(id -un)}.menu"
clone="$HOME/.config/omarchy/plugins/$plugin_id"
marker="$clone/.linear-carbon-menu"
stage=$(mktemp -d)
trap 'rm -rf -- "$stage"' EXIT

fingerprint() (
  cd -- "$1"
  find . -type f ! -name .linear-carbon-menu -print0 |
    sort -z | xargs -0 -r sha256sum
)

cp -aL "$source_dir" "$stage/menu"
patch --batch --forward --fuzz=0 -d "$stage/menu" -p1 <"$theme_notch/omarchy-menu.patch"

if [[ -e "$clone" || -L "$clone" ]]; then
  if [[ ! -f "$marker" ]] || ! fingerprint "$clone" | cmp -s - "$marker"; then
    echo "The existing menu clone has local changes. Its files were preserved." >&2
    exit 1
  fi
else
  omarchy plugin clone omarchy.menu
fi

cp "$clone/manifest.json" "$stage/menu/manifest.json"
omarchy plugin validate "$stage/menu"
cp -a "$stage/menu/." "$clone/"
fingerprint "$clone" > "$marker"
omarchy restart shell
