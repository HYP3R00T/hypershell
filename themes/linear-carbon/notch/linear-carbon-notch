#!/usr/bin/env bash
set -euo pipefail

# This hook runs on theme changes and after a Wayland desktop starts.
[[ -n ${WAYLAND_DISPLAY:-} && -n ${XDG_RUNTIME_DIR:-} ]] || exit 0

config="$HOME/.config/omarchy/themes/linear-carbon/notch/shell.qml"
[[ -f "$config" ]] || exit 0
config=$(realpath -e -- "$config")

# Theme hooks can overlap. Read the committed theme once this hook has the lock.
exec 9>"$XDG_RUNTIME_DIR/linear-carbon-notch.lock"
flock 9
theme=""
if [[ -r "$HOME/.local/state/omarchy/current/theme.name" ]]; then
  read -r theme <"$HOME/.local/state/omarchy/current/theme.name" || true
fi

instances=$(LC_ALL=C qs list -p "$config" 9>&- 2>/dev/null || true)
if [[ "$theme" == linear-carbon ]]; then
  if [[ "$instances" != *"Process ID:"* ]]; then
    qs -n -d -p "$config" 9>&-
  fi
elif [[ "$instances" == *"Process ID:"* ]]; then
  qs kill -p "$config" 9>&-
fi
