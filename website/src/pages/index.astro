---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sitePath, themes } from "@/data/themes";
---
<BaseLayout title="HyperShell" description="Browse HyperShell themes for Omarchy and try their desktops in your browser.">
  <main id="main-content" class="site-width">
    <section class="intro" aria-labelledby="page-title">
      <div>
        <p class="eyebrow"><span></span> Themes for Omarchy</p>
        <h1 id="page-title">HyperShell<span>.</span></h1>
      </div>
      <p class="intro-copy">Explore Omarchy themes and try their desktops right in your browser.</p>
    </section>

    <section id="themes" class="theme-gallery" aria-labelledby="themes-title">
      <h2 id="themes-title">Themes</h2>
      <ul class="theme-list">
        {themes.map(theme => (
          <li>
            <a class="theme-card" href={sitePath(`themes/${theme.slug}/`)} aria-labelledby={`${theme.slug}-title`}>
              <div class="theme-card-preview">
                <img src={sitePath(theme.wallpaper)} alt="" width="1920" height="960" />
                <span class="theme-card-notch" aria-hidden="true"></span>
                <span class="theme-card-dock" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
              </div>
              <div class="theme-card-copy">
                <h3 id={`${theme.slug}-title`}>{theme.name}</h3>
                <p>{theme.description}</p>
                <span class="theme-card-action">Try the theme</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>
